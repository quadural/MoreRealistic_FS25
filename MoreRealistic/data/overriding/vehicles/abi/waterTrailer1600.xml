<?xml version="1.0" encoding="utf-8" standalone="no"?>
<vehicle type="waterTrailer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

    <MR inlineAxleNumber="2">true</MR>

    <mrSuspension referenceMass="7000" />

    <!--
        abi 1600 gallons water trailer

        1600 gallons (6056 liters)

        axle rating = 18000 lbs (8164kg)
        empty weight = 1210kg (with honda ebgine, pipes, sprinklers, pond fill system
        loaded weight with water = 16020 lbs (7266kg)

        max flow rate = 140 gallon per minute (honda engine 3450rpm)
        => 530L/min => 8.83L/s (this is the maximum speed possible, IRL, the avg speed would be lower) => for game purpose, we set it to 50%more => 13.25L/s (player would want a better trailer anyway)

        no brakes
    -->

    <parentFile xmlFilename="$data/vehicles/abi/waterTrailer1600/waterTrailer1600.xml">
        <attributes>

            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 0.95 -0.5"/>
            <set path="vehicle.base.components.component(0)#mass" value="940"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="50"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="50"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#spring" value="50"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#spring" value="50"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="8"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="8"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#damper" value="8"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#damper" value="8"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#suspTravel" value="0.1"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#suspTravel" value="0.1"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#suspTravel" value="0.1"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#suspTravel" value="0.1"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#yOffset" value="-0.008"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#yOffset" value="-0.008"/>

            <!-- no brake -->
            <set path="vehicle.attachable.brakeForce#force" value="0"/>
            <set path="vehicle.attachable.brakeForce#maxForce" value="0"/>

            <!-- fillUnit - varying center of mass function of fillLevel -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 1.3 -0.65"/>

            <!-- empty speed -->
            <set path="vehicle.dischargeable.dischargeNode(0)#emptySpeed" value="13.25"/>

            <!-- fill trigger -->
            <set path="vehicle.fillTriggerVehicle#litersPerSecond" value="13.25"/>

            <!-- fill speed -->
            <set path="vehicle.waterTrailer#fillLitersPerSecond" value="13.25"/>

            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 0.76 1" />

        </attributes>
    </parentFile>

</vehicle>