<?xml version="1.0" encoding="utf-8" standalone="no"?>
<vehicle type="trailer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

    <MR inlineAxleNumber="2">true</MR>

    <mrSuspension referenceMass="12000" />

    <!--
        maxLiterPerSecond = spread unit passage clearance width x height * 1.6 * FX (FX = 1 when no spread unit cover, FX = 0.8 when cover + discs)
        powerFx = 1 when no spread unit cover, powerFx = 1.4 when cover + discs

        options in game =
        - low drawbar
        - bigger wheels
        - high sides
        about 4100kg
    -->

    <mrManureSpreader>
        <config workareaIndex="1" idlePower="1" powerFx="1" maxLiterPerSecond="62" /> <!-- F4V -->
        <config workareaIndex="2" idlePower="1" powerFx="1.4" maxLiterPerSecond="50" /> <!-- CL2-2 = more working width but lower peak output = lower maximum working speed -->
    </mrManureSpreader>


    <parentFile xmlFilename="$data/vehicles/brantner/ta12050/ta12050.xml">
        <attributes>

            <set path="vehicle.configurationSets.configurationSet(1)#name" value="CL2-2" /> <!-- this is not a F4V since there are only 2 horizonal beaters -->

            <set path="vehicle.base.speedLimit#value" value="20" /> <!-- MR engine will regulate the speed limit according to the "maxLiterPerSecond" of the spreader unit -->


            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.2 0.2"/>
            <set path="vehicle.base.components.component(0)#mass" value="3500"/>

            <remove path="vehicle.attachable.brakeForce" />
            <set path="vehicle.attachable.brakeForce#force" value="1.5"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#suspTravel" value="0.15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#suspTravel" value="0.15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#suspTravel" value="0.15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#suspTravel" value="0.15"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="50"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="50"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#spring" value="50"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#spring" value="50"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#damper" value="3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#damper" value="3"/>

            <set path="vehicle.powerConsumer#ptoRpm" value="490" /> <!-- pto -->


            <!-- fill center of mass -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 1.7 0.6"/>

            <!-- correct capacity according to ingame config -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#capacity" value="10500"/>

            <!-- drawbar -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 0.94 1" />

            <!-- lift the back door higher -->
            <set path="vehicle.animations.animation(0).part(0)#startTrans" value="0 1.1 0" />
            <set path="vehicle.animations.animation(1).part(0)#startTrans" value="0 1.1 0" />

            <!-- animation speed -->
            <set path="vehicle.foldable.foldingConfigurations.foldingConfiguration(0).foldingParts.foldingPart(0)#speedScale" value="0.5" />
            <set path="vehicle.foldable.foldingConfigurations.foldingConfiguration(1).foldingParts.foldingPart(0)#speedScale" value="0.5" />

        </attributes>
    </parentFile>

</vehicle>