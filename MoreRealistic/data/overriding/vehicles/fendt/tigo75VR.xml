<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="forageWagon" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

<MR inlineAxleNumber="2">true</MR>
<mrSuspension referenceMass="20000" />
<mrForageWagon idlePower="4" powerFx="1" unloadingPower="30" />

    <!--
        gross weight = 24000kg
        base empty weight = 10450kg + articulating drawbar + knives sharpening system = 10700kg
        max drawbar load = 4000kg

        DIN volume = 40.5M3


        running gear = 24T hydropneumatic tandem, 40% brake efficiency => 24*0.4/4 = 2.4

        -->

    <parentFile xmlFilename="$data/vehicles/fendt/tigo75VR/tigo75VR.xml">
        <attributes>

            <set path="vehicle.base.speedLimit#value" value="20" />

            <remove path="vehicle.base.components#maxMass" />
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.6 -0.6"/>
            <set path="vehicle.base.components.component(0)#mass" value="9320"/>
            <set path="vehicle.base.components.component(1)#centerOfMass" value="0 -0.2 0"/>
            <set path="vehicle.base.components.component(1)#mass" value="350"/>

            <remove path="vehicle.attachable.brakeForce" />
            <set path="vehicle.attachable.brakeForce#force" value="2.4"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="80"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="80"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#spring" value="80"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#spring" value="80"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="8"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="8"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#damper" value="8"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#damper" value="8"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#suspTravel" value="0.15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#suspTravel" value="0.15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#suspTravel" value="0.15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#suspTravel" value="0.15"/>

            <!-- <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#yOffset" value="0.015"/> -->
            <!-- <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#yOffset" value="0.015"/> -->

            <!-- without additive -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 2.5 -0.5"/>

            <!-- with additive -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(1).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 2.5 -0.5"/>

            <!-- empty speed -->
            <set path="vehicle.dischargeable.dischargeNode(0)#emptySpeed" value="1012"/> <!-- about 40s to fully unload -->

            <!-- drawbar protection against tractor's wheel -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 0.89 1" />
            <set path="vehicle.attachable.steeringAxleAngleScale#endSpeed" value="25" />

            <!-- unloading does consume engine power (hydraulics) even if PTO is turned off -->
            <set path="vehicle.dischargeable#consumePower" value="true" />

            <!-- remove axle rotation with hydraulic drawbar -->
            <remove path="vehicle.animations.animation(2).part(1)" />
            <remove path="vehicle.animations.animation(2).part(1)" />
            <remove path="vehicle.animations.animation(2).part(1)" />
            <remove path="vehicle.animations.animation(2).part(1)" />

        </attributes>
    </parentFile>

</vehicle>