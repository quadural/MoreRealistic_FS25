<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="forageWagon" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

<MR>true</MR>
<mrForageWagon idlePower="2" powerFx="0.7" unloadingPower="12" />

    <!--
        gross weight = 5900kg
        base empty weight = 2300kg
        max drawbar load = 900kg

        DIN volume = 16.1M3
        Compressed capacity = 25M3

        running gear = 5.9T, 25% brake efficiency => 5.9*0.25/2 = 0.74

        in the game model, the axle brake is "manual" (no hydraulic or pneumatic braking command !)

        the "fillToGroundScale" value of "GRASS_WINDROW" is "crazy" (value of 6 in the file "maps_densityMapHeightTypes.xml" of the "maps" folder of the game) => when unloading on the ground, we get a heap that has nothing to do with what we should get with such a trailer
    -->

    <parentFile xmlFilename="$data/vehicles/poettinger/bossAlpin251/bossAlpin251.xml">
        <attributes>

            <set path="vehicle.base.speedLimit#value" value="15" />

            <remove path="vehicle.base.components#maxMass" />
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 0.9 0"/>
            <set path="vehicle.base.components.component(0)#mass" value="1950"/>
            <set path="vehicle.base.components.component(1)#centerOfMass" value="0 0 -0.15"/>
            <set path="vehicle.base.components.component(1)#mass" value="200"/>

            <remove path="vehicle.attachable.brakeForce" />
            <set path="vehicle.attachable.brakeForce#force" value="0.7"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="90"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="90"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="4"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="4"/>

            <!-- replace wrong pickup wheels -->
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2)#filename" value="$data/shared/wheels/tires/trelleborg/T510/15x6_00R6.xml" />
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3)#filename" value="$data/shared/wheels/tires/trelleborg/T510/15x6_00R6.xml" />

            <!-- without additive -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 1.6 -0.67"/>

            <!-- with additive -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(1).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 1.6 -0.67"/>

            <!-- empty speed -->
            <set path="vehicle.dischargeable.dischargeNode(0)#emptySpeed" value="670"/> <!-- about 24s to fully unload -->

            <!-- unloading does consume engine power (hydraulics) even if PTO is turned off -->
            <set path="vehicle.dischargeable#consumePower" value="true" />

        </attributes>
    </parentFile>

</vehicle>