<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="forageWagon" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

<MR inlineAxleNumber="2">true</MR>
<mrSuspension referenceMass="14000" />
<mrForageWagon idlePower="3" powerFx="0.9" unloadingPower="20" />

    <!--
        gross weight = 18000kg
        base empty weight = 6050kg + 13T axles and 560/45R22.5 tires => 6300kg
        max drawbar load = 2000kg

        DIN volume = 22M3
        Compressed capacity = 40M3

        running gear = 18T, 35% brake efficiency => 18*0.35/4 = 1.6

        -->

    <parentFile xmlFilename="$data/vehicles/poettinger/faro4010D/faro4010D.xml">
        <attributes>

            <set path="vehicle.base.speedLimit#value" value="20" />

            <remove path="vehicle.base.components#maxMass" />
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.3 0.5"/>
            <set path="vehicle.base.components.component(0)#mass" value="5450"/>
            <set path="vehicle.base.components.component(1)#centerOfMass" value="0 -0.05 -0.2"/>
            <set path="vehicle.base.components.component(1)#mass" value="220"/>

            <remove path="vehicle.attachable.brakeForce" />
            <set path="vehicle.attachable.brakeForce#force" value="1.6"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="70"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="70"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#spring" value="70"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#spring" value="70"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="4"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="4"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#damper" value="4"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#damper" value="4"/>

            <!-- without additive -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 1.9 -0.2"/>

            <!-- with additive -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(1).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 1.9 -0.2"/>

            <!-- empty speed -->
            <set path="vehicle.dischargeable.dischargeNode(0)#emptySpeed" value="750"/> <!-- about 30s to fully unload -->

            <!-- drawbar protection against tractor's wheel -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 0.89 1" />

            <!-- unloading does consume engine power (hydraulics) even if PTO is turned off -->
            <set path="vehicle.dischargeable#consumePower" value="true" />

        </attributes>
    </parentFile>

</vehicle>