<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="forageWagon" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

<MR inlineAxleNumber="2">true</MR>
<mrSuspension referenceMass="27000" />
<mrForageWagon idlePower="4" powerFx="1" unloadingPower="35" />

    <!--
        gross weight = 24000kg
        base empty weight = 12550kg + rear pickup roller + sharpening system + third discharge beater + steering axle + body extension => about 13000 kg in game
        max drawbar load = 4000kg

        DIN volume = 45M3 (47.3M3 with extension)
        Compressed capacity = 76M3

        running gear = 24T, 40% brake efficiency => 24*0.4/4 = 2.4

        -->

    <parentFile xmlFilename="$data/vehicles/poettinger/jumbo8450DB/jumbo8450DB.xml">
        <attributes>

            <set path="vehicle.base.speedLimit#value" value="20" />

            <remove path="vehicle.base.componentConfigurations.componentConfiguration(0)#maxMass" />
            <set path="vehicle.base.componentConfigurations.componentConfiguration(0).component(0)#centerOfMass" value="0 1.6 -0.4"/>
            <set path="vehicle.base.componentConfigurations.componentConfiguration(0).component(0)#mass" value="11450"/>
            <set path="vehicle.base.componentConfigurations.componentConfiguration(0).component(1)#centerOfMass" value="0 -0.2 0.1"/>
            <set path="vehicle.base.componentConfigurations.componentConfiguration(0).component(1)#mass" value="520"/>

            <remove path="vehicle.base.componentConfigurations.componentConfiguration(1)#maxMass" />
            <set path="vehicle.base.componentConfigurations.componentConfiguration(1).component(0)#centerOfMass" value="0 1.3 0.5"/>
            <set path="vehicle.base.componentConfigurations.componentConfiguration(1).component(0)#mass" value="12000"/>


            <remove path="vehicle.attachable.brakeForce" />
            <set path="vehicle.attachable.brakeForce#force" value="2.4"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="100"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="100"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#spring" value="100"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#spring" value="100"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="10"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="10"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#damper" value="10"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#damper" value="10"/>

            <!-- without additive -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 2.6 -0.8"/>

            <!-- with additive -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(1).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 2.6 -0.8"/>

            <!-- empty speed -->
            <set path="vehicle.dischargeable.dischargeNode(0)#emptySpeed" value="1200"/> <!-- about 40s to fully unload -->

            <!-- drawbar protection against tractor's wheel -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 0.89 1" />
            <set path="vehicle.attachable.steeringAxleAngleScale#endSpeed" value="25" />

            <!-- unloading does consume engine power (hydraulics) even if PTO is turned off -->
            <set path="vehicle.dischargeable#consumePower" value="true" />

            <!-- remove axle rotation with hydraulic drawbar -->
            <remove path="vehicle.animations.animation(1).part(1)" />
            <remove path="vehicle.animations.animation(1).part(1)" />

        </attributes>
    </parentFile>

</vehicle>