<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="windrower" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

    <MR>true</MR>

    <mrWindrower rakingWidth="7.3" /> <!-- 2x365cm -->

    <!--

        2420kg

    -->

    <parentFile xmlFilename="$data/vehicles/samasz/z2840/z2840.xml">
        <attributes>

            <set path="vehicle.base.speedLimit#value" value="12" />

            <remove path="vehicle.base.components.component(0)#inertiaScale" />
            <set path="vehicle.base.components.component(0)#mass" value="810" /> <!-- main -->
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 0.8 -0.1" />

            <set path="vehicle.base.components.component(1)#mass" value="250" /> <!-- attacher -->
            <set path="vehicle.base.components.component(1)#centerOfMass" value="0 0 -0.18" />

            <set path="vehicle.base.components.component(2)#mass" value="550" /> <!-- left wing -->
            <set path="vehicle.base.components.component(2)#centerOfMass" value="-0.15 -0.1 0" />

            <set path="vehicle.base.components.component(3)#mass" value="550" /> <!-- right wing -->
            <set path="vehicle.base.components.component(3)#centerOfMass" value="0.15 -0.1 0" />

            <set path="vehicle.base.components.joint(0)#rotLimitSpring" value="0 0 100" />
            <set path="vehicle.base.components.joint(0)#rotLimitDamping" value="0 0 10" />

            <set path="vehicle.base.components.joint(1)#transDrivePosition" value="0 1 0" />
            <set path="vehicle.base.components.joint(1)#transDriveSpring" value="0 1000 0" />
            <set path="vehicle.base.components.joint(1)#transDriveDamping" value="0 100 0" />
            <set path="vehicle.base.components.joint(1)#maxTransDriveForce" value="0 4 0" /> <!-- we want to lift about 400kg => 3.92Kn -->

            <set path="vehicle.base.components.joint(2)#transDrivePosition" value="0 1 0" />
            <set path="vehicle.base.components.joint(2)#transDriveSpring" value="0 1000 0" />
            <set path="vehicle.base.components.joint(2)#transDriveDamping" value="0 100 0" />
            <set path="vehicle.base.components.joint(2)#maxTransDriveForce" value="0 4 0" /> <!-- we want to lift about 400kg => 3.92Kn -->

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="30"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="30"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#initialCompression" value="20"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#initialCompression" value="20"/>


            <remove path="vehicle.powerConsumer" />
            <set path="vehicle.powerConsumer#ptoRpm" value="380" />

            <remove path="vehicle.attachable.brakeForce" />


            <!-- remove moving center of mass -->
            <remove path="vehicle.animations.animation(0).part(10)" />
            <remove path="vehicle.animations.animation(0).part(10)" />

            <!-- drawbar rot limit -->
            <set path="vehicle.base.components.joint(0)#rotLimit" value="0 64 0" />
            <set path="vehicle.animations.animation(2).part(0)#startRotLimit" value="0 64 0" />


        </attributes>
    </parentFile>

</vehicle>
