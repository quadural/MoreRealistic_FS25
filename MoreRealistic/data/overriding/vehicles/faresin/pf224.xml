<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="mixerWagon" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

<MR inlineAxleNumber="2">true</MR>

<mrMixerWagon idlePower="6" mixingPowerFx="1" unloadingPower="5" />



    <!--

        vertical mixer (2 rotors)
        about 45-50KW max PTO use

        base weight = 8220kg (no option, single axle with basic 215/75R17.5 duals tires). => In game = about 8500-8600kg (2 axles, hydraulic counter-knives)

        rotor  speed = 23rpm

        no brakes

        correct tires = duals or 435/50R19.5

        single 215/75R17.5 = ridiculous (both looking and technically)

    -->

    <parentFile xmlFilename="$data/vehicles/faresin/pf224/pf224.xml">
        <attributes>

            <remove path="vehicle.base.components#maxMass" />
            <set path="vehicle.base.components.component(0)#mass" value="8000"/>
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.15 0.6"/>

            <remove path="vehicle.attachable.brakeForce" />

            <!-- no suspension -->
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="200"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="200"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#spring" value="200"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#spring" value="200"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#damper" value="5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#damper" value="5"/>

            <!-- more suitable wheels (single 215/75R17.5 = ridiculous. Already at the max load possible when the wagon is empty) -->
            <remove path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0)#dimensions" />
            <remove path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1)#dimensions" />
            <remove path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2)#dimensions" />
            <remove path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(03)#dimensions" />

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0)#filename" value="$data/shared/wheels/tires/continental/contiHybridHD3/245_70R19_5.xml"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1)#filename" value="$data/shared/wheels/tires/continental/contiHybridHD3/245_70R19_5.xml"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2)#filename" value="$data/shared/wheels/tires/continental/contiHybridHD3/245_70R19_5.xml"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3)#filename" value="$data/shared/wheels/tires/continental/contiHybridHD3/245_70R19_5.xml"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#xOffset" value="-0.17"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#xOffset" value="-0.17"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#xOffset" value="-0.17"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#xOffset" value="-0.17"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0)#configId" value="dual"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1)#configId" value="dual"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2)#configId" value="dual"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3)#configId" value="dual"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).innerRim#filename" value="$data/shared/wheels/hubs/hubTrucks.i3d"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).innerRim#filename" value="$data/shared/wheels/hubs/hubTrucks.i3d"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).innerRim#filename" value="$data/shared/wheels/hubs/hubTrucks.i3d"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).innerRim#filename" value="$data/shared/wheels/hubs/hubTrucks.i3d"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).innerRim#nodeLeft" value="7|0"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).innerRim#nodeLeft" value="7|0"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).innerRim#nodeLeft" value="7|0"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).innerRim#nodeLeft" value="7|0"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).innerRim#nodeRight" value="7|1"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).innerRim#nodeRight" value="7|1"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).innerRim#nodeRight" value="7|1"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).innerRim#nodeRight" value="7|1"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).innerRim#widthAndDiam" value="18 21"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).innerRim#widthAndDiam" value="18 21"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).innerRim#widthAndDiam" value="18 21"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).innerRim#widthAndDiam" value="18 21"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).innerRim#offset" value="0.04"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).innerRim#offset" value="0.04"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).innerRim#offset" value="0.04"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).innerRim#offset" value="0.04"/>


            <!-- dual wheels -->
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).additionalWheel#offset" value="0.01"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).additionalWheel#offset" value="0.01"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).additionalWheel#offset" value="0.01"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).additionalWheel#offset" value="0.01"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).additionalWheel#filename" value="$data/shared/wheels/tires/continental/contiHybridHD3/245_70R19_5.xml"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).additionalWheel#filename" value="$data/shared/wheels/tires/continental/contiHybridHD3/245_70R19_5.xml"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).additionalWheel#filename" value="$data/shared/wheels/tires/continental/contiHybridHD3/245_70R19_5.xml"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).additionalWheel#filename" value="$data/shared/wheels/tires/continental/contiHybridHD3/245_70R19_5.xml"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).additionalWheel#configId" value="dual"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).additionalWheel#configId" value="dual"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).additionalWheel#configId" value="dual"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).additionalWheel#configId" value="dual"/>


            <set path="vehicle.powerConsumer#ptoRpm" value="480" /> <!-- pto -->

            <!-- drawbar -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 1 1" />
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#attacherHeight" value="0.6" />

            <!--discharge rate -->
            <set path="vehicle.dischargeable.dischargeNode(0)#emptySpeed" value="250" /> <!-- IRL, it would take between 3 and 5min to fully discharge the wagon -->
            <set path="vehicle.dischargeable.dischargeNode(1)#emptySpeed" value="250" />

            <set path="vehicle.mixerWagon.mixAnimationNodes.animationNode(0)#rotSpeed" value="-138" /> <!-- xml param = degree per s. 23 rpm = 138 degrees per second -->
            <set path="vehicle.mixerWagon.mixAnimationNodes.animationNode(1)#rotSpeed" value="-138" />

            <set path="vehicle.mixerWagon#mixingTime" value="30" /> <!-- 30s minimum mixing time -->

            <!-- fill center of mass -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 1.8 0.2"/>

        </attributes>
    </parentFile>

</vehicle>