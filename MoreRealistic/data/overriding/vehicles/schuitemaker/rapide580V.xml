<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="forageWagon" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

<MR inlineAxleNumber="2">true</MR>
<mrSuspension referenceMass="20000" />
<mrForageWagon idlePower="4" powerFx="1" unloadingPower="25" />

    <!--
        gross weight = 24000kg
        base empty weight = 8900kg

        DIN volume = 35M3

        running gear = 24T, 40% brake efficiency => 24*0.4/4 = 2.4

        -->

    <parentFile xmlFilename="$data/vehicles/schuitemaker/rapide580V/rapide580V.xml">
        <attributes>

            <set path="vehicle.base.speedLimit#value" value="20" />

            <remove path="vehicle.base.components#maxMass" />
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.7 -0.9"/>
            <set path="vehicle.base.components.component(0)#mass" value="6200"/>
            <set path="vehicle.base.components.component(1)#centerOfMass" value="0 -0.2 -0.1"/>
            <set path="vehicle.base.components.component(1)#mass" value="300"/>
            <set path="vehicle.base.components.component(2)#centerOfMass" value="0 0.2 0"/>
            <set path="vehicle.base.components.component(2)#mass" value="1500"/>

            <remove path="vehicle.attachable.brakeForce" />
            <set path="vehicle.attachable.brakeForce#force" value="2.4"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="120"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="120"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#spring" value="120"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#spring" value="120"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="4"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="4"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#damper" value="4"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#damper" value="4"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#brakeFactor" value="0.7"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#brakeFactor" value="0.7"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(4).physics#mass" value="0.05"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(5).physics#mass" value="0.05"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(4).physics#spring" value="10"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(5).physics#spring" value="10"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(4).physics#yOffset" value="-0.03"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(5).physics#yOffset" value="-0.03"/>

            <!-- without additive -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 2.7 -1"/>

            <!-- with additive -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(1).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 2.7 -1"/>

            <!-- empty speed -->
            <set path="vehicle.dischargeable.dischargeNode(0)#emptySpeed" value="1100"/> <!-- about 32s to fully unload -->

            <!-- drawbar protection against tractor's wheel -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 0.9 1" />

            <!-- unloading does consume engine power (hydraulics) even if PTO is turned off -->
            <set path="vehicle.dischargeable#consumePower" value="true" />

        </attributes>
    </parentFile>

</vehicle>