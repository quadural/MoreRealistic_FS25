<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="trailer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

    <MR inlineAxleNumber="2">true</MR>

    <mrSuspension referenceMass="30000" />

    <!--
        water volume = 12.1m3
        transport volume 15.3m3 (ISO 7546)

        empty weight 6000kg with 600/55R26.5


        410x180 brake drum
        running gear = 32T, 60% brake efficiency @20T => 20*0.6/4 = 3

    -->

    <parentFile xmlFilename="$data/vehicles/krampe/hp20/hp20.xml">
        <attributes>

            <!-- main body -->
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.2 -0.7"/>
            <set path="vehicle.base.components.component(0)#mass" value="3930"/>

            <!-- left wheels -->
            <set path="vehicle.base.components.component(1)#centerOfMass" value="0 0 0"/>
            <set path="vehicle.base.components.component(1)#mass" value="600"/>
            <set path="vehicle.base.components.component(1)#inertiaScale" value="1 1 6" />

            <!-- right wheels -->
            <set path="vehicle.base.components.component(2)#centerOfMass" value="0 0 0"/>
            <set path="vehicle.base.components.component(2)#mass" value="600"/>
            <set path="vehicle.base.components.component(2)#inertiaScale" value="1 1 6" />

            <set path="vehicle.base.components.joint(0)#rotLimit" value="10 0 0" />
            <set path="vehicle.base.components.joint(1)#rotLimit" value="10 0 0" />


            <remove path="vehicle.attachable.brakeForce" />
            <set path="vehicle.attachable.brakeForce#force" value="3"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#suspTravel" value="0.1"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#suspTravel" value="0.1"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#suspTravel" value="0.1"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#suspTravel" value="0.1"/>


            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="300"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="300"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#spring" value="300"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#spring" value="300"/>


            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="20"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="20"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#damper" value="20"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#damper" value="20"/>


            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 2 -0.9"/>
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#capacity" value="13000" />


            <!-- empty speed -->
            <set path="vehicle.dischargeable.dischargeNode(0)#emptySpeed" value="1200"/> <!-- back -->

            <!-- back door speed-->
            <set path="vehicle.trailer.trailerConfigurations.trailerConfiguration(0).trailer.tipSide(0).doorAnimation#speedScale" value="2.5" />

            <!-- trailer body lowering speed -->
            <set path="vehicle.trailer.trailerConfigurations.trailerConfiguration(0).trailer.tipSide(0).animation#closeSpeedScale" value="1.6" />

            <!-- drawbar -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 1 1" />

        </attributes>
    </parentFile>

</vehicle>