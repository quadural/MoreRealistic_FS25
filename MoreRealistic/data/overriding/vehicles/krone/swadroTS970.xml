<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="windrower" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

    <MR>true</MR>

    <mrWindrower rakingWidth="10.16" /> <!-- 1x296cm + 2x360cm -->

    <!--

        3300kg

    -->

    <parentFile xmlFilename="$data/vehicles/krone/swadroTS970/swadroTS970.xml">
        <attributes>

            <set path="vehicle.base.speedLimit#value" value="12" />

            <remove path="vehicle.base.components.component(0)#inertiaScale" />
            <set path="vehicle.base.components.component(0)#mass" value="1200" /> <!-- main -->
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.25 -0.5" />

            <set path="vehicle.base.components.component(1)#mass" value="300" /> <!-- attacher -->
            <set path="vehicle.base.components.component(1)#centerOfMass" value="0 -0.1 -0.1" />

            <set path="vehicle.base.components.component(2)#mass" value="525" /> <!-- left rotor -->
            <set path="vehicle.base.components.component(2)#centerOfMass" value="0 0 0" />

            <set path="vehicle.base.components.component(3)#mass" value="480" /> <!-- center rotor -->
            <set path="vehicle.base.components.component(3)#centerOfMass" value="0 0 0" />

            <set path="vehicle.base.components.component(4)#mass" value="550" /> <!-- right rotor -->
            <set path="vehicle.base.components.component(4)#centerOfMass" value="0 0 0" />


            <set path="vehicle.base.components.joint(1)#transDrivePosition" value="0 1 0" />
            <set path="vehicle.base.components.joint(1)#transDriveSpring" value="0 1000 0" />
            <set path="vehicle.base.components.joint(1)#transDriveDamping" value="0 100 0" />
            <set path="vehicle.base.components.joint(1)#maxTransDriveForce" value="0 3.68 0" /> <!-- we want to lift about 375kg => 3.68Kn -->

            <set path="vehicle.base.components.joint(2)#transDrivePosition" value="0 1 0" />
            <set path="vehicle.base.components.joint(2)#transDriveSpring" value="0 1000 0" />
            <set path="vehicle.base.components.joint(2)#transDriveDamping" value="0 100 0" />
            <set path="vehicle.base.components.joint(2)#maxTransDriveForce" value="0 3.24 0" /> <!-- we want to lift about 330kg => 3.24Kn -->

            <set path="vehicle.base.components.joint(3)#transDrivePosition" value="0 1 0" />
            <set path="vehicle.base.components.joint(3)#transDriveSpring" value="0 1000 0" />
            <set path="vehicle.base.components.joint(3)#transDriveDamping" value="0 100 0" />
            <set path="vehicle.base.components.joint(3)#maxTransDriveForce" value="0 3.9 0" /> <!-- we want to lift about 400kg => 3.92Kn -->

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="40"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="40"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#initialCompression" value="20"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#initialCompression" value="20"/>


            <remove path="vehicle.powerConsumer" />
            <set path="vehicle.powerConsumer#ptoRpm" value="380" />

            <remove path="vehicle.attachable.brakeForce" />

            <!-- drawbar rot limit -->
            <set path="vehicle.animations.animation(4).part(0)#startRotLimit" value="0 66 0" />

            <!-- rear rotor is slower than the other 2 -->
            <set path="vehicle.windrower.animationNodes.animationNode(2)#rotSpeed" value="-210" />


        </attributes>
    </parentFile>

</vehicle>
