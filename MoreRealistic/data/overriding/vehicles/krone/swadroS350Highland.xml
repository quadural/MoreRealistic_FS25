<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="windrower" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

    <MR>true</MR>

    <!-- light construction windrower for hillside farming -->
    <mrWindrower rakingWidth="2.7" powerFx="0.9" />

    <!--

        highland = hillside version (light)
        465kg

        option 4 wheels + front wheel + hydraulic lifting "swath cloth"
        => 530kg

    -->

    <parentFile xmlFilename="$data/vehicles/krone/swadroS350Highland/swadroS350Highland.xml">
        <attributes>

            <set path="vehicle.base.speedLimit#value" value="12" />

            <set path="vehicle.base.components.component(0)#mass" value="315" /> <!-- main -->
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 0.65 0.05" />

            <set path="vehicle.base.components.component(1)#mass" value="100" /> <!-- attacher -->
            <set path="vehicle.base.components.component(1)#centerOfMass" value="0 0 -0.1" />

            <set path="vehicle.base.components.component(2)#mass" value="55" /> <!-- axle -->
            <set path="vehicle.base.components.component(2)#centerOfMass" value="0 0 0.05" />

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#yOffset" value="0.01"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#yOffset" value="0.01"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#spring" value="15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#spring" value="15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#damper" value="3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#damper" value="3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#yOffset" value="0.01"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#yOffset" value="0.01"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(4).physics#spring" value="15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(4).physics#damper" value="3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(4).physics#yOffset" value="0.01"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#rotationDamping" value="0.0001" />
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#rotationDamping" value="0.0001" />
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#rotationDamping" value="0.0001" />
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#rotationDamping" value="0.0001" />
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(4).physics#rotationDamping" value="0.0001" />


            <remove path="vehicle.powerConsumer" />
            <set path="vehicle.powerConsumer#ptoRpm" value="380" />

            <remove path="vehicle.attachable.brakeForce" />
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#mrLowerRotationOffset" value="0" />
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#upperRotationOffset" value="20" />
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0).distanceToGround#lower" value="0.32" />
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0).distanceToGround#upper" value="0.75" />

            <!-- correct limit even when raised -->
            <set path="vehicle.animations.animation(2).part(0)#startRotMaxLimit" value="15 0 0" />

            <remove path="vehicle.animations.animation(1).part(0)#startRotLimit" />
            <remove path="vehicle.animations.animation(1).part(0)#endRotLimit" />
            <set path="vehicle.animations.animation(1).part(0)#startRotMinLimit" value="0 0 0" />
            <set path="vehicle.animations.animation(1).part(0)#startRotMaxLimit" value="15 0 0" />
            <set path="vehicle.animations.animation(1).part(0)#endRotMinLimit" value="0 0 0" />
            <set path="vehicle.animations.animation(1).part(0)#endRotMaxLimit" value="15 0 0" />


        </attributes>
    </parentFile>

</vehicle>
