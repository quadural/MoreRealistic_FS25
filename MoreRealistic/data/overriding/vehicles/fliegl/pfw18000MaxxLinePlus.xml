<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="manureBarrel" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

<MR inlineAxleNumber="2">true</MR>>

<mrSuspension referenceMass="24000" />

<!-- slurry tanker specific settings - screw pump here, not vaccum -->
<mrManureBarrel pumpingPower="30" pumpingLitersPerMinute="7800" workingPower="22" workingMaxLitersPerMinute="5500" workingPumpIsVacuum="false" noRegulation="true" pumpingPtoRpm="540" workingPtoRpm="380"  />

    <!--


        Skate 150 boom => 5500L/min max ?

        pump = wangen GL 65 F 145.0 excentric screw pump

        in game config = 9700-9800kg with Fliegl Skate 150 boom + Fliegl TWIN (1600kg)
        18000L

        BPW brake drums 410x180
        running gear = 20T, 60% brake efficiency @40kph => 20*0.6/4 = 3

    -->

    <parentFile xmlFilename="$data/vehicles/fliegl/pfw18000MaxxLinePlus/pfw18000MaxxLinePlus.xml">
        <attributes>

            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.5 -0.5" /> <!-- main body -->
            <set path="vehicle.base.components.component(0)#mass" value="7500"/>

            <set path="vehicle.base.components.component(1)#centerOfMass" value="0 -0.5 -0.2"/> <!-- ramp -->
            <set path="vehicle.base.components.component(1)#mass" value="700"/>

            <remove path="vehicle.attachable.brakeForce" />
            <set path="vehicle.attachable.brakeForce#force" value="3"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#suspTravel" value="0.14"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#suspTravel" value="0.14"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#suspTravel" value="0.14"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#suspTravel" value="0.14"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="90"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="90"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#spring" value="90"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#spring" value="90"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="9"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="9"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#damper" value="9"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#damper" value="9"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#yOffset" value="0.045"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#yOffset" value="0.045"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#yOffset" value="0.04"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#yOffset" value="0.04"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#mrABS" value="true"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#mrABS" value="true"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#mrABS" value="true"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#mrABS" value="true"/>


            <set path="vehicle.fillTriggerVehicle#litersPerSecond" value="130" /> <!-- about 7800L/min when unloading -->

            <set path="vehicle.dischargeable.dischargeNode#emptySpeed" value="130" /> <!-- about 7800L/min when unloading -->

            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 1.9 -0.7"/>


            <!-- drawbar -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 0.80 1" />
            <set path="vehicle.attachable.steeringAxleAngleScale#endSpeed" value="35" />
            <set path="vehicle.attachable.steeringAxleAngleScale#speedDependent" value="true" />



        </attributes>
    </parentFile>

</vehicle>