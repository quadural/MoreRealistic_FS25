<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="mixerWagon" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

<MR inlineAxleNumber="3">true</MR>

<mrSuspension referenceMass="33000" />

<mrMixerWagon idlePower="9" mixingPowerFx="1" unloadingPower="7" />



    <!--

        vertical mixer (3 rotors)
        about 90-110KW max PTO use

        base weight = 13000kg (35m3 version with tandem axles, no option)

        in game = 13700kg (35M3 version with tridem + front discharge conveyor : 2 sides + rear discharge chutes : 2 sides)

        rotor  speed = 23rpm

        running gear = 27T, 60% brake efficiency => 27*0.6/6 = 2.7

    -->

    <parentFile xmlFilename="$data/vehicles/siloking/trailedLine4System1000/trailedLine4System1000.xml">
        <attributes>

            <set path="vehicle.storeData.specs.neededPower" value="200" /> <!-- 200Hp sufficient, especially for the 35M3 version, and even for the 45M3 version if the TMR is maxed with hay and straw compared to silage -->

            <remove path="vehicle.base.components#maxMass" />
            <set path="vehicle.base.components.component(0)#mass" value="13000"/>
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.3 -1.35"/>

            <remove path="vehicle.attachable.brakeForce" />
            <set path="vehicle.attachable.brakeForce#force" value="2.7"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).steeringAxle#scale" value="0.3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).steeringAxle#scale" value="0.3"/>


            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="150"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="150"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#spring" value="150"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#spring" value="150"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(4).physics#spring" value="150"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(5).physics#spring" value="150"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#damper" value="5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#damper" value="5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(4).physics#damper" value="5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(5).physics#damper" value="5"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#suspTravel" value="0.14"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#suspTravel" value="0.14"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#suspTravel" value="0.14"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#suspTravel" value="0.14"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(4).physics#suspTravel" value="0.14"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(5).physics#suspTravel" value="0.14"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#yOffset" value="0.02"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#yOffset" value="0.02"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#yOffset" value="0.02"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#yOffset" value="0.02"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(4).physics#yOffset" value="0.02"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(5).physics#yOffset" value="0.02"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#mrABS" value="true"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#mrABS" value="true"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#mrABS" value="true"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#mrABS" value="true"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(4).physics#mrABS" value="true"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(5).physics#mrABS" value="true"/>

            <!-- 35 = no extension + turbo augers 2 windings -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 1.95 -1.1"/>

            <!-- 40 = extension + turbo augers 3 windings -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(1).objectChange(13)#node" value="trailedLine4System1000_main_component1"/>
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(1).objectChange(13)#mrAddMassActive" value="700"/>
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(1).objectChange(13)#mrAddMassCOMActive" value="0 2.6 -1.3"/>
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(1).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 2.2 -1.1"/>

            <!-- 45 = extension + turbo augers 3.5 windings -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(2).objectChange(13)#node" value="trailedLine4System1000_main_component1"/>
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(2).objectChange(13)#mrAddMassActive" value="1200"/> <!-- +500kg -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(2).objectChange(13)#mrAddMassCOMActive" value="0 2.8 -1.3"/>
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(2).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 2.3 -1.1"/>




            <set path="vehicle.powerConsumer#ptoRpm" value="480" /> <!-- pto -->

            <!-- drawbar -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 1 1" />
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#attacherHeight" value="0.7" />

            <!--discharge rate -->
            <set path="vehicle.dischargeable.dischargeNode(0)#emptySpeed" value="300" /> <!-- front conveyor -->
            <set path="vehicle.dischargeable.dischargeNode(1)#emptySpeed" value="300" />
            <set path="vehicle.dischargeable.dischargeNode(2)#emptySpeed" value="550" /> <!-- rear chute -->
            <set path="vehicle.dischargeable.dischargeNode(3)#emptySpeed" value="550" />

            <set path="vehicle.mixerWagon.mixAnimationNodes.animationNode(0)#rotSpeed" value="-132" /> <!-- xml param = degree per s. 22 rpm = 132 degrees per second -->
            <set path="vehicle.mixerWagon.mixAnimationNodes.animationNode(1)#rotSpeed" value="-132" />
            <set path="vehicle.mixerWagon.mixAnimationNodes.animationNode(2)#rotSpeed" value="-132" />

            <set path="vehicle.mixerWagon#mixingTime" value="30" /> <!-- 30s minimum mixing time -->


            <!-- block the steering wheels at "high" speed -->
            <set path="vehicle.attachable.steeringAxleAngleScale#speedDependent" value="true" />
            <set path="vehicle.attachable.steeringAxleAngleScale#startSpeed" value="20" />
            <set path="vehicle.attachable.steeringAxleAngleScale#endSpeed" value="25" />

        </attributes>
    </parentFile>

</vehicle>