<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="forageWagon" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

<MR inlineAxleNumber="3">true</MR>
<mrSuspension referenceMass="28000" />
<mrForageWagon idlePower="4" powerFx="1" unloadingPower="40" />

    <!--
        gross weight = 34000kg
        base empty weight = 13300kg
        max drawbar load = 4000kg

        DIN volume = 49.5M3
        Compressed capacity = 89.1M3

        running gear = 34T, 40% brake efficiency => 34*0.4/6 = 2.27

        fix bug : restload of the 6th wheel is set to 19 instead of 1.9

        -->

    <parentFile xmlFilename="$data/vehicles/bergmann/shuttle490S/shuttle490S.xml">
        <attributes>

            <set path="vehicle.base.speedLimit#value" value="20" />

            <remove path="vehicle.base.components#maxMass" />
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.7 -0.4"/>
            <set path="vehicle.base.components.component(0)#mass" value="11300"/>
            <set path="vehicle.base.components.component(1)#centerOfMass" value="0 -0.2 0"/>
            <set path="vehicle.base.components.component(1)#mass" value="500"/>


            <remove path="vehicle.attachable.brakeForce" />
            <set path="vehicle.attachable.brakeForce#force" value="2.2"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="70"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="70"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#spring" value="70"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#spring" value="70"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(4).physics#spring" value="70"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(5).physics#spring" value="70"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="10"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="10"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#damper" value="10"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#damper" value="10"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(4).physics#damper" value="10"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(5).physics#damper" value="10"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#restLoad" value="2"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#restLoad" value="2"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#restLoad" value="2"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#restLoad" value="2"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(4).physics#restLoad" value="2"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(5).physics#restLoad" value="2"/>

            <!-- without additive -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 2.6 -0.6"/>

            <!-- with additive -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(1).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 2.6 -0.6"/>

            <!-- empty speed -->
            <set path="vehicle.dischargeable.dischargeNode(0)#emptySpeed" value="1100"/> <!-- about 45s to fully unload -->

            <!-- drawbar protection against tractor's wheel -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 0.91 1" />
            <set path="vehicle.attachable.steeringAxleAngleScale#endSpeed" value="25" />
            <set path="vehicle.attachable.steeringAxleAngleScale#speedDependent" value="true" />

            <!-- unloading does consume engine power (hydraulics) even if PTO is turned off -->
            <set path="vehicle.dischargeable#consumePower" value="true" />

        </attributes>
    </parentFile>

</vehicle>