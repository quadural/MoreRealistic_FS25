<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="windrower" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

    <MR>true</MR>

    <mrWindrower rakingWidth="7.6" powerFx="1.3" /> <!-- 2x380cm // all hydraulic merger = less power efficient-->

    <!--

        5000kg
        100 to 180hp needed (depending on hills, crop)
        very high max working speed (28kph)

        no brakes

    -->

    <parentFile xmlFilename="$data/vehicles/andersonGroup/mergePro915/mergePro915.xml">
        <attributes>

            <set path="vehicle.base.speedLimit#value" value="28" />


            <set path="vehicle.base.components.component(0)#mass" value="2400" /> <!-- main -->
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1 -1.6" />

            <set path="vehicle.base.components.component(1)#mass" value="300" /> <!-- attacher -->
            <set path="vehicle.base.components.component(1)#centerOfMass" value="0 0.15 -0.25" />

            <set path="vehicle.base.components.component(2)#mass" value="1000" /> <!-- left wing -->
            <set path="vehicle.base.components.component(2)#centerOfMass" value="0.01 0 0" />

            <set path="vehicle.base.components.component(3)#mass" value="1000" /> <!-- right wing -->
            <set path="vehicle.base.components.component(3)#centerOfMass" value="-0.01 0 0" />



            <set path="vehicle.base.components.joint(1)#transDrivePosition" value="0 1 0" />
            <set path="vehicle.base.components.joint(1)#transDriveSpring" value="0 1000 0" />
            <set path="vehicle.base.components.joint(1)#transDriveDamping" value="0 100 0" />
            <set path="vehicle.base.components.joint(1)#maxTransDriveForce" value="0 7.85 0" /> <!-- we want to lift about 800kg => 7.85Kn -->

            <set path="vehicle.base.components.joint(2)#transDrivePosition" value="0 1 0" />
            <set path="vehicle.base.components.joint(2)#transDriveSpring" value="0 1000 0" />
            <set path="vehicle.base.components.joint(2)#transDriveDamping" value="0 100 0" />
            <set path="vehicle.base.components.joint(2)#maxTransDriveForce" value="0 7.85 0" /> <!-- we want to lift about 800kg => 7.85Kn -->


            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="80"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="80"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#initialCompression" value="27"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#initialCompression" value="27"/>


            <remove path="vehicle.powerConsumer" />
            <set path="vehicle.powerConsumer#ptoRpm" value="380" />

            <remove path="vehicle.attachable.brakeForce#force" />

            <!-- add some rot limit to allow follow the ground - not visible, only the "rigid body" -->
            <set path="vehicle.animations.animation(7).part(4)#startRotLimit" value="0 0 10" />
            <set path="vehicle.animations.animation(7).part(4)#endRotLimit" value="0 0 0" />
            <set path="vehicle.animations.animation(7).part(5)#startRotLimit" value="0 0 10" />
            <set path="vehicle.animations.animation(7).part(5)#endRotLimit" value="0 0 0" />


        </attributes>
    </parentFile>

</vehicle>
