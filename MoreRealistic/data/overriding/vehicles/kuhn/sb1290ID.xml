<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="baler" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

    <MR inlineAxleNumber="2">true</MR>


    <mrBaler idlePower="15" powerIncreaseWithFeedingKilosPerSecond="5" maxTonsPerHour="58" grassCapacityFx="2.4" densityFactor="1.3" strokesPerMinute="46" strokePower="250" feedingChamberMinRequiredLevel="170" strokeAnimationName="balingAnimation" strokeAnimationStrokeTime="0.18" strokeAnimationSoundStartTime="0.18" strokeAnimationMultipleStrokesStep="0.5" />


    <!--

    13000kg with 680/50R22.5

    46 strokes per minutes => 0.766667 strokes per second
    baling animation => endTime = 2 (but 2 full roations) => scaleSpeed should be set to 0.76667 instead of 0.7


    FIX in the lua code to get a "moreRealistic" large square baler =
    1. pto power function of the stroke (and the load on the baler)
    2. bale moving animation function of the stroke (and the feeding chamber level)
    3. synchronize the "stroke animation" with the "stroke sound"



    -->

    <parentFile xmlFilename="$data/vehicles/kuhn/sb1290ID/sb1290ID.xml">
        <attributes>

            <set path="vehicle.base.speedLimit#value" value="25" />
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.5 0.6" />
            <set path="vehicle.base.components.component(0)#mass" value="11900" />

            <set path="vehicle.base.components.component(1)#centerOfMass" value="0 -0.1 0" /> <!-- pickup -->
            <set path="vehicle.base.components.component(1)#mass" value="250" />
            <set path="vehicle.base.components.component(1)#inertiaScale" value="1 1 1" />

            <set path="vehicle.powerConsumer#ptoRpm" value="540" />

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0)#dimensions" value="680_50R22_5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1)#dimensions" value="680_50R22_5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2)#dimensions" value="680_50R22_5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3)#dimensions" value="680_50R22_5"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#suspTravel" value="0.15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#suspTravel" value="0.15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#suspTravel" value="0.15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#suspTravel" value="0.15"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="60"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="60"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#spring" value="60"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#spring" value="60"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#damper" value="5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#damper" value="5"/>

            <!-- air brakes -->
            <set path="vehicle.attachable.brakeForce#force" value="1.5" />

            <!-- drawbar -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 0.88 1" />
            <set path="vehicle.attachable.steeringAxleAngleScale#endSpeed" value="25" />

            <!-- correct strokes per minutes - animation endTime = 2 but there are 2 full rotation per animation, we want 2.6s for the full animation => we have to raise the animation speed -->
            <set path="vehicle.turnOnVehicle.turnedOnAnimation#speedScale" value="0.76667" />

            <!-- sound pitch to get 46 strokes per minutes
            sound file = data\sounds\tools\baler\attBalerWrappingLoop_02.ogg => there are 4 strokes in 5.0554 seconds
            to get 46 strokes per minutes (0.766667 strokes per second) => picthscale = 0.968951667
            -->
            <set path="vehicle.baler.sounds.work#pitchScale" value="0.968951667" />

        </attributes>
    </parentFile>

</vehicle>