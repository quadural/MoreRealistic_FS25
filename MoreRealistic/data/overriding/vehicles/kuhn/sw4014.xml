<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="baleWrapper" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

    <MR>true</MR>

    <mrWrapper activePower="9" baleMassDependingPower="5" />

    <!--

        wrapping heads = 35rpm
        bale length = 2m max
        bale diamter = 1.4m max
        bale mass = 1500kg max

        hydraulics : 40 to 60 L/min => 13-20KW

        std tires = 380/55R17
        large = 480/45R17

        mass = 2800-3400kg

    -->

    <parentFile xmlFilename="$data/vehicles/kuhn/sw4014/sw4014.xml">
        <attributes>

            <!-- main -->
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0.74 1 -0.1" /> <!-- double check moving centerOfMass too -->
            <set path="vehicle.base.components.component(0)#mass" value="2500" />

            <!-- attacher -->
            <set path="vehicle.base.components.component(1)#centerOfMass" value="0 0 0" />
            <set path="vehicle.base.components.component(1)#mass" value="250" /> <!-- for game physics stability = no less than 10% of the total mass, and/or cheats with inertiaScale -->


            <set path="vehicle.powerConsumer#ptoRpm" value="340" /> <!-- hydraulics only, no pto -->

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#suspTravel" value="0.08"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#suspTravel" value="0.08"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="60"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="60"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="1"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="1"/>


            <!-- small air brakes -->
            <set path="vehicle.attachable.brakeForce#force" value="0.7" />

            <!-- wraps rollers -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0).fillMassNode#node" value="sw4014_main_component1"/>
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="2.2 1.5 1.92"/>

            <!-- attacher angle with tractor -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#upperRotationOffset" value="0" />
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#mrLowerRotationOffset" value="0" />

            <!-- folding speed -->
            <set path="vehicle.foldable.foldingConfigurations.foldingConfiguration(0).foldingParts.foldingPart(0)#speedScale" value="0.5" />

            <!-- missing moving center of mass -->
            <set path="vehicle.animations.animation(2).part(10)#componentIndex" value="1" />
            <set path="vehicle.animations.animation(2).part(10)#startTime" value="1" />
            <set path="vehicle.animations.animation(2).part(10)#endTime" value="5" />
            <set path="vehicle.animations.animation(2).part(10)#startCenterOfMass" value="0.4 1 -0.1" />
            <set path="vehicle.animations.animation(2).part(10)#endCenterOfMass" value="0.74 1 -0.1" />

            <!-- wrap speed -->
            <set path="vehicle.baleWrapper.roundBaleWrapper#wrappingTime" value="16.25" /> <!-- 13s / 0.8 since we have slow down the animation scaleSpeed-->
            <set path="vehicle.baleWrapper.roundBaleWrapper.baleTypes.baleType(0).animations.wrapBale#animSpeed" value="0.8" />
            <set path="vehicle.baleWrapper.roundBaleWrapper.baleTypes.baleType(1).animations.wrapBale#animSpeed" value="0.8" />

            <set path="vehicle.baleWrapper.squareBaleWrapper#wrappingTime" value="16.25" /> <!-- 13s / 0.8 since we have slow down the animation scaleSpeed-->
            <set path="vehicle.baleWrapper.squareBaleWrapper.baleTypes.baleType(0).animations.wrapBale#animSpeed" value="0.8" />
            <set path="vehicle.baleWrapper.squareBaleWrapper.baleTypes.baleType(1).animations.wrapBale#animSpeed" value="0.8" />


        </attributes>
    </parentFile>

</vehicle>