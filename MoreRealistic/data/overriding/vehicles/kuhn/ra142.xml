<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="mixerWagon" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

<MR>true</MR>

<mrMixerWagon idlePower="5" mixingPowerFx="0.7" unloadingPower="0" /> <!-- no additionnal power when unloading -->



    <!--

        "reel auggie" = less power then vertical mixer
        about 20KW max PTO use

        base weight = 5125kg (no option, basic tires). In game = 5200kg
        net load (max) = 5715kg
        tongue weight = about 9% (about 975kg when fully loaded)
        reel speed = 6.25rpm

        no brakes

        correct tires = 385/65R22.5 (or 425/65R22.5)

    -->

    <parentFile xmlFilename="$data/vehicles/kuhn/ra142/ra142.xml">
        <attributes>

            <remove path="vehicle.base.components#maxMass" />
            <set path="vehicle.base.components.component(0)#mass" value="4900"/>
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.15 -0.2"/>

            <remove path="vehicle.attachable.brakeForce" />

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="200"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="200"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="5"/>

            <!-- more suitable wheels -->
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0)#filename" value="$data/shared/wheels/tires/continental/offRoadHCS/445_65R22_5.xml"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1)#filename" value="$data/shared/wheels/tires/continental/offRoadHCS/445_65R22_5.xml"/>

            <set path="vehicle.powerConsumer#ptoRpm" value="480" /> <!-- pto -->

            <!-- drawbar -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 0.9 1" />

            <!--discharge rate -->
            <set path="vehicle.dischargeable.dischargeNode#emptySpeed" value="120" /> <!-- IRL, it would take between 3 and 5min to fully discharge the wagon -->

            <set path="vehicle.mixerWagon.mixAnimationNodes.animationNode(0)#rotSpeed" value="37.5" /> <!-- xml param = degree per s. 6.25 rpm = 37.5 degrees per second -->
            <set path="vehicle.mixerWagon.mixAnimationNodes.animationNode(1)#rotSpeed" value="216" /> <!-- upper auger = 36 rpm -->
            <set path="vehicle.mixerWagon.mixAnimationNodes.animationNode(2)#rotSpeed" value="192" /> <!-- lower auger = 32 rpm -->
            <set path="vehicle.mixerWagon#mixingTime" value="30" /> <!-- 30s minimum mixing time -->

            <!-- fix broken fillLevel display (we want to see kilos, not liters. And we want the figures to be updated when looking at the display scale, even from the loading tractor... -->
            <set path="vehicle.dashboard#maxUpdateDistance" value="35"/>
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0).dashboard#valueType" value="mrFillMass" />

            <!-- fill center of mass -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 1.8 -0.3"/>

        </attributes>
    </parentFile>

</vehicle>