<?xml version="1.0" encoding="utf-8" standalone="no"?>
<vehicle type="manureSpreader" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

    <MR inlineAxleNumber="2">true</MR>

    <mrSuspension referenceMass="18000" />

    <!--
        maxLiterPerSecond = spread unit passage clearance width x height * 1.6 * FX (FX = 1 when no spread unit cover, FX = 0.8 when cover + discs)
        powerFx = (simplified formula to take into account spreading technology) = (width/3)^0.6

        options in game =
        - self-steering axle
        - universal spreading unit
        - Protective grille
        about 6700kg
    -->

    <mrManureSpreader idlePower="1.5" powerFx="2.3" maxLiterPerSecond="75" />



    <parentFile xmlFilename="$data/vehicles/hawe/dst16/dst16.xml">
        <attributes>

            <set path="vehicle.base.speedLimit#value" value="20" /> <!-- MR engine will regulate the speed limit according to the "maxLiterPerSecond" of the spreader unit -->


            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.45 0.2"/>
            <set path="vehicle.base.components.component(0)#mass" value="6000"/>

            <remove path="vehicle.attachable.brakeForce" />
            <set path="vehicle.attachable.brakeForce#force" value="2"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#suspTravel" value="0.15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#suspTravel" value="0.15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#suspTravel" value="0.15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#suspTravel" value="0.15"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="70"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="70"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#spring" value="70"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#spring" value="70"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="4"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="4"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#damper" value="4"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#damper" value="4"/>

            <set path="vehicle.powerConsumer#ptoRpm" value="490" /> <!-- pto -->


            <!-- fill center of mass -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 1.95 0.4"/>

            <!-- drawbar -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 0.93 1" />
            <set path="vehicle.attachable.steeringAxleAngleScale#endSpeed" value="35" />
            <set path="vehicle.attachable.steeringAxleAngleScale#speedDependent" value="true" />

        </attributes>
    </parentFile>

</vehicle>