<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="baler" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

    <MR>true</MR>

    <mrWrapper activePower="7" baleMassDependingPower="4" />

    <!--



    -->

    <parentFile xmlFilename="$data/vehicles/goeweil/g5020/g5020.xml">
        <attributes>

            <!-- main -->
            <set path="vehicle.base.componentConfigurations.componentConfiguration(0).component(0)#centerOfMass" value="0.1 0.7 -0.4" />
            <set path="vehicle.base.componentConfigurations.componentConfiguration(0).component(0)#mass" value="1280" />
            <!-- drawbar -->
            <set path="vehicle.base.componentConfigurations.componentConfiguration(0).component(1)#centerOfMass" value="0 -0.4 -0.2" />
            <set path="vehicle.base.componentConfigurations.componentConfiguration(0).component(1)#mass" value="200" />
            <!-- attacher -->
            <set path="vehicle.base.componentConfigurations.componentConfiguration(0).component(2)#centerOfMass" value="0 0 0" />
            <set path="vehicle.base.componentConfigurations.componentConfiguration(0).component(2)#mass" value="150" />

            <!--2nd config with rear tail to tip off unloading bales -->
            <!-- main -->
            <set path="vehicle.base.componentConfigurations.componentConfiguration(1).component(0)#centerOfMass" value="0.1 0.7 -0.4" />
            <set path="vehicle.base.componentConfigurations.componentConfiguration(1).component(0)#mass" value="1280" />
            <!-- drawbar -->
            <set path="vehicle.base.componentConfigurations.componentConfiguration(1).component(1)#centerOfMass" value="0 -0.4 -0.2" />
            <set path="vehicle.base.componentConfigurations.componentConfiguration(1).component(1)#mass" value="200" />
            <!-- attacher -->
            <set path="vehicle.base.componentConfigurations.componentConfiguration(1).component(2)#centerOfMass" value="0 0 0" />
            <set path="vehicle.base.componentConfigurations.componentConfiguration(1).component(2)#mass" value="150" />
            <!-- bale turner -->
            <set path="vehicle.base.componentConfigurations.componentConfiguration(1).component(3)#centerOfMass" value="0 0 -0.4" />
            <set path="vehicle.base.componentConfigurations.componentConfiguration(1).component(3)#mass" value="180" />



            <set path="vehicle.powerConsumer#ptoRpm" value="340" /> <!-- hydraulics only, no pto -->

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#suspTravel" value="0.08"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#suspTravel" value="0.08"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="60"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="60"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="1"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="1"/>


            <!-- no brakes -->
            <set path="vehicle.attachable.brakeForce#force" value="0" />

            <!-- wraps rollers -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0).fillMassNode#node" value="g5020_drawbar_component2"/>
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 0.15 0.3"/>

            <!-- attacher angle with tractor -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#upperRotationOffset" value="0" />
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#mrLowerRotationOffset" value="0" />

            <!-- attacher rot limit -->
            <!-- we can't set à "realistic value here : same bug than in previous FS game = "movingPart with dependantPart" can't handle more than 90° without glitching visually (component = ok, but visual part = totally "torn" apart) -->
            <!-- <set path="vehicle.connectedAttributes.attribute.target(1)#values" value="- y-100 -45 - y+90 45" /> -->

            <!-- folding speed -->
            <set path="vehicle.foldable.foldingConfigurations.foldingConfiguration(0).foldingParts.foldingPart(0)#speedScale" value="0.5" />
            <set path="vehicle.foldable.foldingConfigurations.foldingConfiguration(1).foldingParts.foldingPart(0)#speedScale" value="0.5" />

            <!-- wrap speed : more turns => not possible. It seems the "wrappingFoilAnimation relies on the "wrap125Source" clip which is intended for 6 turns. No more, no less-->
            <set path="vehicle.baleWrapper.roundBaleWrapper#wrappingTime" value="17.1428" /> <!-- 12s / 0.7 since we have slow down the animation scaleSpeed-->

            <set path="vehicle.baleWrapper.roundBaleWrapper.baleTypes.baleType(0).animations.wrapBale#animSpeed" value="0.7" />
            <!-- <set path="vehicle.baleWrapper.roundBaleWrapper.baleTypes.baleType(0).wrappingFoilAnimation#maxRot" value="-4320" /> -->

            <set path="vehicle.baleWrapper.roundBaleWrapper.baleTypes.baleType(1).animations.wrapBale#animSpeed" value="0.7" />
            <!-- <set path="vehicle.baleWrapper.roundBaleWrapper.baleTypes.baleType(1).wrappingFoilAnimation#maxRot" value="-4320" /> -->

            <!-- <set path="vehicle.animations.animation(4).part(0)#endRot" value="0 -4320 0" /> -->
            <!-- <set path="vehicle.animations.animation(4).part(1)#endRot" value="0 0 610" /> -->
            <!-- <set path="vehicle.animations.animation(4).part(2)#endRot" value="0 0 610" /> -->

            <!-- <set path="vehicle.animations.animation(5).part(0)#endRot" value="0 -4320 0" /> -->
            <!-- <set path="vehicle.animations.animation(5).part(1)#endRot" value="0 0 610" /> -->
            <!-- <set path="vehicle.animations.animation(5).part(2)#endRot" value="0 0 610" /> -->

            <!-- <remove path="vehicle.baleWrapper.roundBaleWrapper.baleTypes.baleType(0).wrappingState" /> -->
            <!-- <remove path="vehicle.baleWrapper.roundBaleWrapper.baleTypes.baleType(1).wrappingState" /> -->



        </attributes>
    </parentFile>

</vehicle>