<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="strawBlower" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

<MR>true</MR>

<mrStrawBlower idlePower="10" activePower="45" cutterPosition="-1 1.3 0.36" />

    <!--

        IRL bales capacity =
        3 big squares
        or 2 round bales

        3300kg empty weight


        no brakes
    -->

    <parentFile xmlFilename="$data/vehicles/elmersMfg/ravage/ravage.xml">
        <attributes>

            <set path="vehicle.base.components.component(0)#mass" value="2700"/>
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.05 0.6"/>

            <set path="vehicle.base.components.component(1)#mass" value="300"/>
            <set path="vehicle.base.components.component(1)#centerOfMass" value="0 0.2 -0.2"/>

            <remove path="vehicle.attachable.brakeForce" />

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="70"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="70"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="5"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="5"/>

            <set path="vehicle.powerConsumer#ptoRpm" value="480" /> <!-- pto -->

            <!-- drawbar -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 0.94 1" />

            <!-- more speed in "wide" discharge position -->
            <set path="vehicle.dischargeable.dischargeNode(1)#emptySpeed" value="500" />

        </attributes>
    </parentFile>

</vehicle>