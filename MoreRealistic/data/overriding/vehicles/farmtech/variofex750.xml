<?xml version="1.0" encoding="utf-8" standalone="no"?>
<vehicle type="manureSpreader" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

    <MR>true</MR>

    <mrSuspension referenceMass="7500" />

    <!--
        maxLiterPerSecond = spread unit passage clearance width x height * 1.6 * FX (FX = 1 when no spread unit cover, FX = 0.8 when cover + discs)
        powerFx = (simplified formula to take into account spreading technology) = (width/3)^0.6

        options in game =
        1200mm side

        about 2800kg

        narrow mode = 1m on the right side + 1m on the left side (usageScale is set to 3m which means 50% more liters per ha compared to normal mode)
    -->

    <mrManureSpreader idlePower="1" powerFx="1.8" maxLiterPerSecond="36">
        <workMode index="1" maxLiterPerSecondFx="0.4" /> <!-- narrow mode = lower output. this not possible to feed as much material per second compared to full width spreading -->
    </mrManureSpreader>


    <parentFile xmlFilename="$data/vehicles/farmtech/variofex750/variofex750.xml">
        <attributes>

            <set path="vehicle.base.speedLimit#value" value="20" /> <!-- MR engine will regulate the speed limit according to the "maxLiterPerSecond" of the spreader unit -->


            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.25 -0.4"/>
            <set path="vehicle.base.components.component(0)#mass" value="2600"/>

            <remove path="vehicle.attachable.brakeForce" />
            <set path="vehicle.attachable.brakeForce#force" value="1.35"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#suspTravel" value="0.08"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#suspTravel" value="0.08"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="90"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="90"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="3"/>


            <set path="vehicle.powerConsumer#ptoRpm" value="490" /> <!-- pto -->


            <!-- fill center of mass -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 1.5 -0.3"/>

            <!-- correct capacity according to ingame config -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#capacity" value="5700"/>

            <!-- drawbar -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 0.95 1" />

        </attributes>
    </parentFile>

</vehicle>