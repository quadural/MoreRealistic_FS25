<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="windrower" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

    <MR>true</MR>
    <mrWindrower rakingWidth="2.5" powerFx="0.8" idlePower="1" /> <!-- belt rake = less power needed -->

    <!--

        300kg

        correct tires seems to be = 15x6-6
        but doesn't look "right" in game

    -->

    <parentFile xmlFilename="$data/vehicles/sip/favorit254/favorit254.xml">
        <attributes>

            <set path="vehicle.base.speedLimit#value" value="12" />

            <set path="vehicle.base.components.component(0)#mass" value="190" /> <!-- main -->
            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 0.45 0.02" />

            <set path="vehicle.base.components.component(1)#mass" value="100" /> <!-- attacher -->
            <set path="vehicle.base.components.component(1)#centerOfMass" value="0 -0.1 0.05" />

            <!-- <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0)#filename" value="$data/shared/wheels/tires/trelleborg/T510/15x6_00R6.xml"/> -->
            <!-- <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1)#filename" value="$data/shared/wheels/tires/trelleborg/T510/15x6_00R6.xml"/> -->

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="25"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="25"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="3"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#initialCompression" value="20"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#initialCompression" value="20"/>

            <remove path="vehicle.powerConsumer" />
            <set path="vehicle.powerConsumer#ptoRpm" value="380" />

            <remove path="vehicle.attachable.brakeForce" />
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#mrLowerRotationOffset" value="-3" />
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#upperRotationOffset" value="8" />
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0).distanceToGround#lower" value="0.4" />
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0).distanceToGround#upper" value="0.7" />

        </attributes>
    </parentFile>

</vehicle>
