<?xml version="1.0" encoding="utf-8" standalone="no"?>
<vehicle type="manureSpreader" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">

    <MR inlineAxleNumber="2">true</MR>

    <mrSuspension referenceMass="36000" />

    <!--

        US235 = Universal Sprayer + 2 axles + 35M3 (heap)
        but in the game, the fillVolume is quite "low" = only 26-27M3
        so we keep the base game value of 30.3M3

        options in game =
        border hydraulic deflector
        650/55R30.5

        about 13900kg empty

    -->

    <mrManureSpreader idlePower="4" powerFx="2.6" maxLiterPerSecond="150" />



    <parentFile xmlFilename="$data/vehicles/samsonAgro/us235/us235.xml">
        <attributes>

            <set path="vehicle.base.speedLimit#value" value="20" /> <!-- MR engine will regulate the speed limit according to the "maxLiterPerSecond" of the spreader unit -->


            <set path="vehicle.base.components.component(0)#centerOfMass" value="0 1.9 -0.5"/>
            <set path="vehicle.base.components.component(0)#mass" value="12660"/>

            <remove path="vehicle.attachable.brakeForce" />
            <set path="vehicle.attachable.brakeForce#force" value="5"/>

            <!-- correct tires -->
            <!-- <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0)#saveId" value="MRDEFAULT" /> -->
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0)#dimensions" value="650_65R30_5" />
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1)#dimensions" value="650_65R30_5" />
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2)#dimensions" value="650_65R30_5" />
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3)#dimensions" value="650_65R30_5" />

            <!-- <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(1)#saveId" value="MRBROAD" /> -->
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(1).wheels.wheel(0)#dimensions" value="850_50R30_5" />
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(1).wheels.wheel(1)#dimensions" value="850_50R30_5" />
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(1).wheels.wheel(2)#dimensions" value="850_50R30_5" />
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(1).wheels.wheel(3)#dimensions" value="850_50R30_5" />



            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#suspTravel" value="0.25"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#suspTravel" value="0.25"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#suspTravel" value="0.25"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#suspTravel" value="0.25"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#spring" value="90"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#spring" value="90"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#spring" value="90"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#spring" value="90"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#damper" value="6"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#damper" value="6"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#damper" value="6"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#damper" value="6"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#yOffset" value="0.05"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#yOffset" value="0.05"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#yOffset" value="0.01"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#yOffset" value="0.01"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(0).physics#mrABS" value="true"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(1).physics#mrABS" value="true"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).physics#mrABS" value="true"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).physics#mrABS" value="true"/>

            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).steeringAxle#rotMax" value="15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).steeringAxle#rotMax" value="15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(2).steeringAxle#rotMin" value="-15"/>
            <set path="vehicle.wheels.wheelConfigurations.wheelConfiguration(0).wheels.wheel(3).steeringAxle#rotMin" value="-15"/>



            <set path="vehicle.powerConsumer#ptoRpm" value="490" /> <!-- pto -->

            <!-- correct capacity according to ingame config -->
            <!-- <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#capacity" value="28000"/>  never fully filled in game... -->

            <!-- fill center of mass -->
            <set path="vehicle.fillUnit.fillUnitConfigurations.fillUnitConfiguration(0).fillUnits.fillUnit(0)#mrCenterOfMass" value="0 2.7 -0.4"/>

            <!-- drawbar -->
            <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#lowerRotLimitScale" value="1 0.92 1" />
            <set path="vehicle.attachable.steeringAxleAngleScale#endSpeed" value="40" />
            <set path="vehicle.attachable.steeringAxleAngleScale#speedDependent" value="true" />



        </attributes>
    </parentFile>

</vehicle>